<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>qdbridge</AssemblyName>
    <!-- default = Native AOT. Baseline comparison: pass PublishAot=false, PublishSingleFile=true and self-contained on the command line. -->
    <PublishAot Condition="'$(PublishAot)' == ''">true</PublishAot>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
