<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>   <!-- only for the NotifyIcon tray variant -->
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>wpfproto</AssemblyName>
    <RootNamespace>WpfProto</RootNamespace>
  </PropertyGroup>
</Project>
