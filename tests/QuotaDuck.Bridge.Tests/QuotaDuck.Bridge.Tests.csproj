<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>QuotaDuck.Bridge.Tests</RootNamespace>
  </PropertyGroup>
  <!-- Dev-only test framework (approved in CLAUDE.md). Nothing here ships. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\QuotaDuck.Core\QuotaDuck.Core.csproj" />
    <ProjectReference Include="..\..\src\QuotaDuck.Bridge\QuotaDuck.Bridge.csproj" />
    <!-- built (for process-level tests) but NOT referenced as an assembly: it has the same type names as the production bridge -->
    <ProjectReference Include="..\QuotaDuck.Bridge.TestSeam\QuotaDuck.Bridge.TestSeam.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- shared synthetic payload builders (dependency-free) -->
    <Compile Include="..\QuotaDuck.Core.Tests\PayloadFx.cs" Link="PayloadFx.cs" />
  </ItemGroup>
</Project>
