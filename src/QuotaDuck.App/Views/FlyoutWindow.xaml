<Window x:Class="QuotaDuck.App.Views.FlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:QuotaDuck.App.Views"
        Title="QuotaDuck" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStyle="ToolWindow" ShowInTaskbar="False" ShowActivated="True" Topmost="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal"
        FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
        Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"
        KeyboardNavigation.TabNavigation="Cycle"
        AutomationProperties.Name="QuotaDuck quota">
    <!-- A small work area, a tall setup guide or a large display scale scrolls instead of running off the screen: MaxHeight is the work area. Normal operation never scrolls. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <views:CompactFlyoutContent x:Name="Body" />
    </ScrollViewer>
</Window>
