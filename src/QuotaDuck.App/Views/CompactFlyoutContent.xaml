<UserControl x:Class="QuotaDuck.App.Views.CompactFlyoutContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:QuotaDuck.App.Views"
             FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal"
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
             Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <UserControl.Resources>
        <views:ToneBrushConverter x:Key="ToneBrush" />
        <views:NullToVisibilityConverter x:Key="Show" />
        <BooleanToVisibilityConverter x:Key="BoolToVisible" />

        <!-- Accessibility only (no visual effect): WPF names a list item by its ToString(), which for a record is a raw "CompactRowModel { ... }" dump.
             An explicit name on the item container makes screen readers read the row's own sentence instead. -->
        <Style x:Key="RowContainer" TargetType="ContentPresenter">
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>

        <views:ButtonIconConverter x:Key="Icon" />
        <views:ButtonLabelConverter x:Key="Label" />

        <!-- Icon buttons (A+ 2). The Button keeps its plain-string Content (the status text), its explicit accessible name, tooltip, keyboard focus and
             the system template (so the focus rectangle and High Contrast behave as before); only the ContentTemplate draws the icon. -->
        <DataTemplate x:Key="CopyIcon">
            <Path Data="{Binding Converter={StaticResource Icon}, ConverterParameter=copy}" Width="16" Height="16" Stretch="None" StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </DataTemplate>
        <DataTemplate x:Key="RefreshIcon">
            <StackPanel Orientation="Horizontal">
                <Path Data="{Binding Converter={StaticResource Icon}, ConverterParameter=refresh}" Width="16" Height="16" Stretch="None" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                <!-- the cooldown seconds stay visible next to the icon -->
                <TextBlock Text="{Binding Converter={StaticResource Label}, ConverterParameter=refresh}" Margin="5,0,0,0" FontSize="12" VerticalAlignment="Center"
                           Visibility="{Binding Text, RelativeSource={RelativeSource Self}, Converter={StaticResource Show}}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="BothIcon">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Path Data="{Binding Converter={StaticResource Icon}, ConverterParameter=both}" Width="16" Height="16" Stretch="None" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                <TextBlock Text="{Binding Converter={StaticResource Label}, ConverterParameter=both}" Margin="6,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Padding" Value="6,0" />
        </Style>

        <!-- 5-hour / Weekly: label (+ OLD / RESET badge) | the remaining % as the hero number, then the gauge, then the reset line -->
        <DataTemplate x:Key="Row">
            <StackPanel Margin="0,7,0,0" AutomationProperties.Name="{Binding AccessibleName}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding Hero}" FontSize="26" FontWeight="Bold" LineHeight="28" LineStackingStrategy="BlockLineHeight" Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                        <TextBlock Text="{Binding HeroUnit}" FontSize="11.5" FontWeight="SemiBold" Margin="4,0,0,3" VerticalAlignment="Bottom" Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Bottom" />
                        <Border BorderThickness="1" CornerRadius="2" Padding="4,0" Margin="6,0,0,1" VerticalAlignment="Bottom" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                                Visibility="{Binding Badge, Converter={StaticResource Show}}">
                            <TextBlock Text="{Binding Badge}" FontSize="10.5" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                </DockPanel>
                <views:PixelImage Scene="{Binding Gauge}" TargetWidth="288" HorizontalAlignment="Left" Margin="0,3,0,2" Decorative="True" />
                <TextBlock Text="{Binding ResetLine}" FontSize="12" Opacity="0.85" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Card">
            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="{x:Static views:CompactFlyoutContent.CardBorder}"
                    CornerRadius="4" Padding="12,8,12,10" Margin="4">
                <StackPanel>
                    <!-- name | subtle status chip (glyph + word) | Refresh (Codex only) | Copy -->
                    <Grid Height="32">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Margin="8,0,0,0" Padding="6,0" VerticalAlignment="Center" BorderThickness="1.5" CornerRadius="3"
                                BorderBrush="{Binding Tone, Converter={StaticResource ToneBrush}}">
                            <TextBlock Text="{Binding Chip}" FontSize="11.5" FontWeight="SemiBold" Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                        </Border>
                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Margin="0,0,6,0" Content="{Binding Refresh.Text}" ContentTemplate="{StaticResource RefreshIcon}"
                                IsEnabled="{Binding Refresh.Enabled}" ToolTip="{Binding Refresh.Hint, TargetNullValue='Refresh Codex quota'}"
                                Visibility="{Binding Refresh, Converter={StaticResource Show}}" Click="OnRefreshClick" AutomationProperties.Name="Refresh Codex quota" />
                        <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="{Binding CopyText}" ContentTemplate="{StaticResource CopyIcon}" ToolTip="{Binding CopyName}"
                                Click="OnCopyProviderClick" AutomationProperties.Name="{Binding CopyName}" />
                    </Grid>
                    <views:PixelImage Scene="{Binding Pond}" TargetWidth="288" HorizontalAlignment="Left" Margin="0,4,0,6"
                                      AutomationProperties.Name="{Binding PondDescription}" />
                    <TextBlock TextWrapping="Wrap" FontSize="12.5">
                        <Run Text="{Binding Headline, Mode=OneWay}" FontWeight="SemiBold" Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" /><Run Text="{Binding AgeSuffix, Mode=OneWay}" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource Row}" ItemContainerStyle="{StaticResource RowContainer}" IsTabStop="False"
                                  Visibility="{Binding HasRows, Converter={StaticResource BoolToVisible}}" />
                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="11.5" Opacity="0.85" Margin="0,4,0,0" Visibility="{Binding Note, Converter={StaticResource Show}}" />
                    <!-- first run: the one-line setup prompt replaces the rows; the guide itself opens below both cards -->
                    <DockPanel Margin="0,6,0,0" Visibility="{Binding Setup, Converter={StaticResource Show}}">
                        <Button DockPanel.Dock="Right" MinWidth="72" Padding="8,2" Content="{Binding SetupButtonText}" Click="OnSetUpClick"
                                AutomationProperties.Name="{Binding SetupButtonName}" />
                        <TextBlock Text="Waiting for terminal setup" VerticalAlignment="Center" FontSize="12" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="Guide">
            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="{x:Static views:CompactFlyoutContent.CardBorder}"
                    CornerRadius="4" Padding="10,8" Margin="4" AutomationProperties.Name="{Binding AccessibleName}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" Opacity="0.9" Margin="0,3,0,0" FontSize="12" />
                    <Expander Header="Why only terminal sessions?" Margin="0,4,0,0" FontSize="12" IsExpanded="False">
                        <TextBlock Text="{Binding Limitation}" TextWrapping="Wrap" Margin="16,3,0,0" FontSize="12" Opacity="0.9" />
                    </Expander>
                    <TextBlock Text="{Binding StepsBefore}" TextWrapping="Wrap" Margin="0,6,0,3" FontSize="12" Visibility="{Binding HasSnippet, Converter={StaticResource BoolToVisible}}" />
                    <TextBox Text="{Binding Snippet, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Padding="4"
                             AutomationProperties.Name="Status line setup text, read only; select it or use Copy" Visibility="{Binding HasSnippet, Converter={StaticResource BoolToVisible}}" />
                    <DockPanel Margin="0,4,0,0" Visibility="{Binding HasSnippet, Converter={StaticResource BoolToVisible}}">
                        <Button DockPanel.Dock="Left" MinWidth="72" Padding="8,2" Content="{Binding CopyLabel}" Click="OnCopyClick" AutomationProperties.Name="Copy the setup text to the clipboard" />
                        <TextBlock Text="{Binding PathNote}" TextWrapping="Wrap" FontSize="11.5" Opacity="0.8" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding PathNote, Converter={StaticResource Show}}" />
                    </DockPanel>
                    <TextBlock Text="{Binding StepsAfter}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" Visibility="{Binding StepsAfter, Converter={StaticResource Show}}" />
                    <TextBlock Text="{Binding RemoveText}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11.5" Opacity="0.8" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Margin="6">
        <UniformGrid x:Name="Cards" Columns="2">
            <ContentControl Content="{Binding Compact.Claude}" ContentTemplate="{StaticResource Card}" IsTabStop="False" />
            <ContentControl Content="{Binding Compact.Codex}" ContentTemplate="{StaticResource Card}" IsTabStop="False" />
        </UniformGrid>
        <!-- the primary way to share both providers at once: a plain-text report to paste into an assistant; the one compact footer note sits beside it -->
        <DockPanel Margin="6,6,6,2" LastChildFill="True">
            <Button DockPanel.Dock="Left" MinWidth="116" Height="30" Padding="12,0" Content="{Binding Compact.CopyBothText}" ContentTemplate="{StaticResource BothIcon}"
                    ToolTip="Copy a plain-text report of Claude and Codex usage, ready to paste into an AI assistant"
                    AutomationProperties.Name="Copy both Claude and Codex usage as text to the clipboard" Click="OnCopyBothClick" />
            <TextBlock Text="{Binding Compact.FooterNote}" TextWrapping="Wrap" FontSize="11.5" Opacity="0.8" Margin="12,0,0,0" VerticalAlignment="Center"
                       Visibility="{Binding Compact.FooterNote, Converter={StaticResource Show}}" />
        </DockPanel>
        <ContentControl Content="{Binding Compact.Guide}" ContentTemplate="{StaticResource Guide}" IsTabStop="False"
                        Visibility="{Binding Compact.Guide, Converter={StaticResource Show}}" />
        <TextBlock Text="{Binding Compact.RefreshFeedback}" TextWrapping="Wrap" Margin="6,2" Visibility="{Binding Compact.RefreshFeedback, Converter={StaticResource Show}}"
                   Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</UserControl>
