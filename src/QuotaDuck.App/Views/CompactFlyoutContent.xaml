<UserControl x:Class="QuotaDuck.App.Views.CompactFlyoutContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:QuotaDuck.App.Views"
             FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Ideal"
             Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
             Foreground="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}">
    <UserControl.Resources>
        <views:ToneBrushConverter x:Key="ToneBrush" />
        <views:NullToVisibilityConverter x:Key="Show" />
        <BooleanToVisibilityConverter x:Key="BoolToVisible" />

        <!-- Accessibility only (no visual effect): WPF names a list item by its ToString(), which for a record is a raw "CompactRowModel { ... }" dump.
             An explicit name on the item container makes screen readers read the row's own sentence instead. -->
        <Style x:Key="RowContainer" TargetType="ContentPresenter">
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>

        <!-- 5-hour / Weekly: label (+ state tag) | "58% left", then the gauge, then the reset line -->
        <DataTemplate x:Key="Row">
            <StackPanel Margin="0,6,0,0" AutomationProperties.Name="{Binding AccessibleName}">
                <DockPanel>
                    <TextBlock Text="{Binding Primary}" DockPanel.Dock="Right" FontWeight="Bold" Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                    <TextBlock VerticalAlignment="Bottom">
                        <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{Binding StateTag, Mode=OneWay}" FontSize="11.5" />
                    </TextBlock>
                </DockPanel>
                <views:PixelImage Scene="{Binding Gauge}" TargetWidth="272" HorizontalAlignment="Left" Margin="0,3,0,2" Decorative="True" />
                <TextBlock Text="{Binding ResetLine}" FontSize="12" Opacity="0.85" TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Card">
            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="{x:Static views:CompactFlyoutContent.CardBorder}"
                    CornerRadius="4" Padding="10,8" Margin="4" MinWidth="296">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" />
                    <views:PixelImage Scene="{Binding Pond}" TargetWidth="296" HorizontalAlignment="Center" Margin="0,4,0,2"
                                      AutomationProperties.Name="{Binding PondDescription}" />
                    <TextBlock Text="{Binding Headline}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="12.5" Foreground="{Binding Tone, Converter={StaticResource ToneBrush}}" />
                    <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource Row}" ItemContainerStyle="{StaticResource RowContainer}" IsTabStop="False"
                                  Visibility="{Binding HasRows, Converter={StaticResource BoolToVisible}}" />
                    <TextBlock Text="{Binding Note}" TextWrapping="Wrap" FontSize="11.5" Opacity="0.85" Margin="0,4,0,0" Visibility="{Binding Note, Converter={StaticResource Show}}" />
                    <!-- first run: the one-line setup prompt replaces the rows; the guide itself opens below both cards -->
                    <DockPanel Margin="0,6,0,0" Visibility="{Binding Setup, Converter={StaticResource Show}}">
                        <Button DockPanel.Dock="Right" MinWidth="72" Padding="8,2" Content="{Binding SetupButtonText}" Click="OnSetUpClick"
                                AutomationProperties.Name="{Binding SetupButtonName}" />
                        <TextBlock Text="Waiting for terminal setup" VerticalAlignment="Center" FontSize="12" />
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" MinWidth="88" Padding="8,2" Content="{Binding Refresh.Text}" IsEnabled="{Binding Refresh.Enabled}" ToolTip="{Binding Refresh.Hint}"
                                Visibility="{Binding Refresh, Converter={StaticResource Show}}" Click="OnRefreshClick" AutomationProperties.Name="Refresh Codex quota" />
                        <TextBlock Text="{Binding Freshness}" FontSize="11.5" Opacity="0.75" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBlock Text="{Binding Footer}" TextWrapping="Wrap" Opacity="0.7" FontSize="11" Margin="0,4,0,0" Visibility="{Binding Footer, Converter={StaticResource Show}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="Guide">
            <Border BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="{x:Static views:CompactFlyoutContent.CardBorder}"
                    CornerRadius="4" Padding="10,8" Margin="4" AutomationProperties.Name="{Binding AccessibleName}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" Opacity="0.9" Margin="0,3,0,0" FontSize="12" />
                    <Expander Header="Why only terminal sessions?" Margin="0,4,0,0" FontSize="12" IsExpanded="False">
                        <TextBlock Text="{Binding Limitation}" TextWrapping="Wrap" Margin="16,3,0,0" FontSize="12" Opacity="0.9" />
                    </Expander>
                    <TextBlock Text="{Binding StepsBefore}" TextWrapping="Wrap" Margin="0,6,0,3" FontSize="12" Visibility="{Binding HasSnippet, Converter={StaticResource BoolToVisible}}" />
                    <TextBox Text="{Binding Snippet, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Padding="4"
                             AutomationProperties.Name="Status line setup text, read only; select it or use Copy" Visibility="{Binding HasSnippet, Converter={StaticResource BoolToVisible}}" />
                    <DockPanel Margin="0,4,0,0" Visibility="{Binding HasSnippet, Converter={StaticResource BoolToVisible}}">
                        <Button DockPanel.Dock="Left" MinWidth="72" Padding="8,2" Content="{Binding CopyLabel}" Click="OnCopyClick" AutomationProperties.Name="Copy the setup text to the clipboard" />
                        <TextBlock Text="{Binding PathNote}" TextWrapping="Wrap" FontSize="11.5" Opacity="0.8" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding PathNote, Converter={StaticResource Show}}" />
                    </DockPanel>
                    <TextBlock Text="{Binding StepsAfter}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="12" Visibility="{Binding StepsAfter, Converter={StaticResource Show}}" />
                    <TextBlock Text="{Binding RemoveText}" TextWrapping="Wrap" Margin="0,6,0,0" FontSize="11.5" Opacity="0.8" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Margin="6">
        <UniformGrid x:Name="Cards" Columns="2">
            <ContentControl Content="{Binding Compact.Claude}" ContentTemplate="{StaticResource Card}" IsTabStop="False" />
            <ContentControl Content="{Binding Compact.Codex}" ContentTemplate="{StaticResource Card}" IsTabStop="False" />
        </UniformGrid>
        <ContentControl Content="{Binding Compact.Guide}" ContentTemplate="{StaticResource Guide}" IsTabStop="False"
                        Visibility="{Binding Compact.Guide, Converter={StaticResource Show}}" />
        <TextBlock Text="{Binding Compact.RefreshFeedback}" TextWrapping="Wrap" Margin="6,2" Visibility="{Binding Compact.RefreshFeedback, Converter={StaticResource Show}}"
                   Foreground="{DynamicResource {x:Static SystemColors.HotTrackBrushKey}}" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
</UserControl>
