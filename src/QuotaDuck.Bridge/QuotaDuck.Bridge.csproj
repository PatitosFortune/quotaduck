<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>quotaduck-statusline</AssemblyName>
    <RootNamespace>QuotaDuck.Bridge</RootNamespace>
    <!-- Native AOT: publish with `-r win-x64` (scripts/verify-bridge-aot.ps1). Plain `dotnet build` stays a normal managed build for tests. -->
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <StackTraceSupport>false</StackTraceSupport>
    <EventSourceSupport>false</EventSourceSupport>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Windows-only by design (DACL, named mutex semantics, Windows paths). -->
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\QuotaDuck.Core\QuotaDuck.Core.csproj" />
    <InternalsVisibleTo Include="QuotaDuck.Bridge.Tests" />
  </ItemGroup>
</Project>
